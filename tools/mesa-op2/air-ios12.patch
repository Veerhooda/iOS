+/*
+ * An attribute's integer that is an EXPRESSION, as iOS 12's Metal compiler writes `[[color(e)]]`
+ * (QuartzCore's ca_uber_fragment_*: `[[color(color_attachment)]]`, where color_attachment is itself
+ * `(frag_buffer_params >> 14) & 3` of a function constant):
+ *
+ *   !{!"air.render_target", ptr addrspace(2) @__metal_implicit_attr_int_expr_N, ...}
+ *   _GLOBAL__sub_I_...:  store i32 %v, ptr addrspace(2) @__metal_implicit_attr_int_expr_N
+ *
+ * iOS 16's compiler folds the expression to an i32 in the metadata. The value is needed while the
+ * interface is laid out, before any code is translated, so it is evaluated here from the bitcode
+ * (eval_const_int); what cannot be evaluated is refused rather than guessed.
+ */
+static bool
+md_int_expr(struct air_ctx *c, const struct air_md *node, unsigned i, uint64_t *out)
+{
+   if (md_int(node, i, out))
+      return true;
+   if (!node || i >= node->num_ops || !node->ops[i] || node->ops[i]->kind != AIR_MD_VALUE)
+      return false;
+   const struct air_value *g = node->ops[i]->value;
+   if (!g || g->kind != AIR_VALUE_GLOBAL)
+      return false;
+   return eval_const_int(c, single_store(c, g), 0, out);
+}
