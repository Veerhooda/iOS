+/*
+ * V as an integer known when the pipeline is created: a constant, a function constant (the
+ * pipeline's value, zero when none), a program-scope variable through its one static-initialiser
+ * store, or integer arithmetic, casts, compares and selects of those. False for anything else.
+ */
+static bool
+eval_const_int(struct air_ctx *c, const struct air_value *v, unsigned depth, uint64_t *out)
+{
+   if (!v || depth > 64)
+      return false;
+   if (air_const_uint(v, out))
+      return true;
+   if (v->kind != AIR_VALUE_INSTRUCTION)
+      return false;
+   const struct air_inst *in = (const struct air_inst *)v;
+   unsigned bits = in->base.type && in->base.type->kind == AIR_TYPE_INT ? in->base.type->bits : 64;
+   uint64_t a = 0, b = 0, t = 0;
+   switch (in->op) {
+   case AIR_OP_LOAD: {
+      const struct air_value *p = in->num_operands ? in->operands[0] : NULL;
+      if (!p || p->kind != AIR_VALUE_GLOBAL)
+         return false;
+      int idx = function_constant_index(c, (const struct air_global *)p);
+      if (idx >= 0) {
+         for (unsigned k = 0; c->options && k < c->options->num_constants; k++) {
+            if (c->options->constants[k].index == (unsigned)idx) {
+               *out = c->options->constants[k].bits & int_mask(bits);
+               return true;
+            }
+         }
+         return false;
+      }
+      if (!eval_const_int(c, single_store(c, p), depth + 1, &a))
+         return false;
+      *out = a & int_mask(bits);
+      return true;
+   }
+   case AIR_OP_BINOP:
+      if (in->num_operands < 2 || !eval_const_int(c, in->operands[0], depth + 1, &a) ||
+          !eval_const_int(c, in->operands[1], depth + 1, &b))
+         return false;
+      switch (in->sub) {
+      case AIR_BINOP_ADD: t = a + b; break;
+      case AIR_BINOP_SUB: t = a - b; break;
+      case AIR_BINOP_MUL: t = a * b; break;
+      case AIR_BINOP_UDIV: if (!b) return false; t = (a & int_mask(bits)) / (b & int_mask(bits)); break;
+      case AIR_BINOP_UREM: if (!b) return false; t = (a & int_mask(bits)) % (b & int_mask(bits)); break;
+      case AIR_BINOP_SHL: if (b >= bits) return false; t = a << b; break;
+      case AIR_BINOP_LSHR: if (b >= bits) return false; t = (a & int_mask(bits)) >> b; break;
+      case AIR_BINOP_ASHR: if (b >= bits) return false; t = (uint64_t)(sext_bits(a, bits) >> b); break;
+      case AIR_BINOP_AND: t = a & b; break;
+      case AIR_BINOP_OR: t = a | b; break;
+      case AIR_BINOP_XOR: t = a ^ b; break;
+      default: return false;
+      }
+      *out = t & int_mask(bits);
+      return true;
+   case AIR_OP_CAST: {
+      if (in->num_operands < 1 || !eval_const_int(c, in->operands[0], depth + 1, &a))
+         return false;
+      const struct air_type *st = in->operands[0]->type;
+      unsigned sbits = st && st->kind == AIR_TYPE_INT ? st->bits : 64;
+      switch (in->sub) {
+      case AIR_CAST_TRUNC: t = a; break;
+      case AIR_CAST_ZEXT: t = a & int_mask(sbits); break;
+      case AIR_CAST_SEXT: t = (uint64_t)sext_bits(a, sbits); break;
+      default: return false;
+      }
+      *out = t & int_mask(bits);
+      return true;
+   }
+   case AIR_OP_CMP: {
+      if (in->num_operands < 2 || !eval_const_int(c, in->operands[0], depth + 1, &a) ||
+          !eval_const_int(c, in->operands[1], depth + 1, &b))
+         return false;
+      const struct air_type *st = in->operands[0]->type;
+      unsigned ob = st && st->kind == AIR_TYPE_INT ? st->bits : 64;
+      uint64_t ua = a & int_mask(ob), ub = b & int_mask(ob);
+      int64_t sa = sext_bits(a, ob), sb = sext_bits(b, ob);
+      bool r;
+      switch (in->sub) {
+      case AIR_ICMP_EQ: r = ua == ub; break;
+      case AIR_ICMP_NE: r = ua != ub; break;
+      case AIR_ICMP_UGT: r = ua > ub; break;
+      case AIR_ICMP_UGE: r = ua >= ub; break;
+      case AIR_ICMP_ULT: r = ua < ub; break;
+      case AIR_ICMP_ULE: r = ua <= ub; break;
+      case AIR_ICMP_SGT: r = sa > sb; break;
+      case AIR_ICMP_SGE: r = sa >= sb; break;
+      case AIR_ICMP_SLT: r = sa < sb; break;
+      case AIR_ICMP_SLE: r = sa <= sb; break;
+      default: return false;
+      }
+      *out = r;
+      return true;
+   }
+   case AIR_OP_CALL: {
+      /* the one call a predicate goes through (air_intrinsics.c): a byte is true if not zero */
+      const struct air_value *callee = in->num_operands ? in->operands[0] : NULL;
+      if (!callee || !callee->name || in->num_operands < 2 ||
+          strcmp(callee->name, "air.normalize_function_constant_predicate") ||
+          !eval_const_int(c, in->operands[1], depth + 1, &a))
+         return false;
+      *out = a != 0;
+      return true;
+   }
+   case AIR_OP_SELECT:
+      if (in->num_operands < 3 || !eval_const_int(c, in->operands[0], depth + 1, &a))
+         return false;
+      if (!eval_const_int(c, in->operands[(a & 1) ? 1 : 2], depth + 1, &b))
+         return false;
+      *out = b & int_mask(bits);
+      return true;
+   default:
+      return false;
+   }
+}
