+static int function_constant_index(struct air_ctx *c, const struct air_global *g);
+
+/*
+ * An attribute's integer that is an EXPRESSION, as iOS 12's Metal compiler writes `[[color(e)]]`
+ * whatever e is (QuartzCore's ca_uber_fragment_*: `[[color(color_attachment)]]`, a function constant):
+ *
+ *   !{!"air.render_target", ptr addrspace(2) @__metal_implicit_attr_int_expr_N, ...}
+ *   _GLOBAL__sub_I_...:  %v = load i32, ptr addrspace(2) @color_attachment
+ *                        store i32 %v, ptr addrspace(2) @__metal_implicit_attr_int_expr_N
+ *
+ * iOS 16's compiler folds the same expression to an i32 in the metadata. The value is needed
+ * while the interface is being laid out, before any code is translated, so it is resolved here
+ * from the bitcode: the global's one store, whose value is an integer constant or a load of a
+ * function constant -- which then answers with the pipeline's value (zero when none). Anything
+ * else (two stores, arithmetic) is refused, by returning false, rather than guessed.
+ */
+/* the one value stored into global G anywhere in the module, or NULL (no store, or more than one) */
+static const struct air_value *
+single_store(struct air_ctx *c, const struct air_value *g)
+{
+   const struct air_value *stored = NULL;
+   unsigned stores = 0;
+   for (unsigned fi = 0; fi < c->m->num_functions; fi++) {
+      const struct air_function *f = c->m->functions[fi];
+      for (unsigned b = 0; b < f->num_blocks; b++) {
+         const struct air_block *blk = &f->blocks[b];
+         for (unsigned k = 0; k < blk->num_insts; k++) {
+            const struct air_inst *in = blk->insts[k];
+            if (in->op == AIR_OP_STORE && in->num_operands >= 2 && in->operands[1] == g) {
+               stored = in->operands[0];
+               stores++;
+            }
+         }
+      }
+   }
+   return stores == 1 ? stored : NULL;
+}
+
+static uint64_t
+int_mask(unsigned bits)
+{
+   return bits >= 64 || bits == 0 ? ~0ull : (1ull << bits) - 1;
+}
+
+static int64_t
+sext_bits(uint64_t v, unsigned bits)
+{
+   if (bits == 0 || bits >= 64)
+      return (int64_t)v;
+   uint64_t m = 1ull << (bits - 1);
+   v &= int_mask(bits);
+   return (int64_t)((v ^ m) - m);
+}
