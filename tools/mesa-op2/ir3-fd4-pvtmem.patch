+/* OnePlus 2 (G4d): scratch (private memory) is private to the invocation, so stores that nothing ever loads
+ * have no effect. iOS 12's CoreAnimation uber shaders, through the AIR front end, write a 220-byte struct of
+ * function-constant values that is never read (117 store_scratch, 0 load_scratch): nir_remove_dead_variables
+ * keeps it because the stores go through pointer casts. On A4xx the driver cannot size private memory (the
+ * per-SP geometry is unknown), and those stores ran hundreds of KB past fd4's fixed 8 KB buffer. Drop them.
+ */
 static bool
+ir3_nir_remove_write_only_scratch(nir_shader *s)
+{
+   nir_foreach_function_impl (impl, s) {
+      nir_foreach_block (block, impl) {
+         nir_foreach_instr (instr, block) {
+            if (instr->type == nir_instr_type_intrinsic &&
+                nir_instr_as_intrinsic(instr)->intrinsic == nir_intrinsic_load_scratch)
+               return false;
+         }
+      }
+   }
+
+   bool progress = false;
+   nir_foreach_function_impl (impl, s) {
+      bool impl_progress = false;
+      nir_foreach_block (block, impl) {
+         nir_foreach_instr_safe (instr, block) {
+            if (instr->type == nir_instr_type_intrinsic &&
+                nir_instr_as_intrinsic(instr)->intrinsic == nir_intrinsic_store_scratch) {
+               nir_instr_remove(instr);
+               impl_progress = true;
+            }
+         }
+      }
+      if (impl_progress)
+         nir_metadata_preserve(impl, nir_metadata_control_flow);
+      else
+         nir_metadata_preserve(impl, nir_metadata_all);
+      progress |= impl_progress;
+   }
+   if (s->scratch_size) {
+      s->scratch_size = 0;
+      progress = true;
+   }
+   return progress;
+}
